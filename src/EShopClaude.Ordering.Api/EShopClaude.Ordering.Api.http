@host = http://localhost:5103

### Service status
GET {{host}}/

### OpenAPI document (Development only)
GET {{host}}/openapi/v1.json

### Create order
POST {{host}}/api/orders
Content-Type: application/json

{
  "buyerId": "dod-buyer",
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "items": [
    { "productId": 1, "productName": "Classic T-Shirt", "unitPrice": 19.99, "quantity": 2 },
    { "productId": 6, "productName": "Backpack", "unitPrice": 59.00, "quantity": 1 }
  ]
}

### List orders
# [] on a fresh run; every created order, ascending id, with lines
GET {{host}}/api/orders

### Get order (created)
# id 1 = first Create order on a fresh run; use the id from its Location header
GET {{host}}/api/orders/1

### Get order (missing → 404)
GET {{host}}/api/orders/999

### Update order (created)
# id 1 = first Create order on a fresh run; replaces buyer, customer and lines, recomputes total, keeps createdAt
PUT {{host}}/api/orders/1
Content-Type: application/json

{
  "buyerId": "dod-buyer-3",
  "customerName": "Grace Hopper",
  "customerEmail": "grace@example.com",
  "items": [
    { "productId": 3, "productName": "Coffee Mug", "unitPrice": 12.50, "quantity": 3 }
  ]
}

### Update order (missing → 404)
PUT {{host}}/api/orders/999
Content-Type: application/json

{
  "buyerId": "dod-buyer-3",
  "customerName": "Grace Hopper",
  "customerEmail": "grace@example.com",
  "items": [
    { "productId": 3, "productName": "Coffee Mug", "unitPrice": 12.50, "quantity": 3 }
  ]
}

### Delete order (created)
# id 1 = first Create order on a fresh run; 204, lines removed by cascade; run again → 404
DELETE {{host}}/api/orders/1

### Delete order (missing → 404)
DELETE {{host}}/api/orders/999
